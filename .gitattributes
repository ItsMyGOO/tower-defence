# Normalize text files
* text=auto eol=lf

# Godot assets and scenes
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
