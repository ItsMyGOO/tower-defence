text = "提示：\n• 点击第②个按钮后，观察屏幕中央是否出现橙红色爆炸粒子，粒子播放结束后应自动消失。\n• 右上角「AudioManager 子节点数」在 SFX/特效结束后应回到基准值 1（仅 BGMPlayer 常驻）。\n• 若数值持续增长则说明存在节点泄漏，需检查 AudioManager 回收逻辑。\n• 音效字段留空则静默不报错，可在 Inspector 中为 AudioManager 挂载真实 .ogg/.wav 音频资源。"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.7, 0.7, 0.8, 1)
