[node name="HintLabel" type="Label" parent="UI" unique_id=1000000015]
offset_left = 40.0
offset_top = 580.0
offset_right = 1240.0
offset_bottom = 700.0
text = "提示：
• 点击第②个按钮后，观察屏幕中央是否出现橙红色爆炸粒子，粒子播放结束后应自动消失，无最后一帧闪烁。
• 右上角分别显示 AudioManager 与 EffectsManager 的子节点数：结束后 AudioManager 应回落至基准值 1（仅 BGMPlayer 常驻），EffectsManager 应回落至 0。
• 若数值持续增长则说明存在节点泄漏，需检查对应 Manager 的回收逻辑。
• AudioManager 音效字段留空则静默不报错，可在 Inspector 中挂载真实 .ogg/.wav 音频资源。
• 击杀特效由 EffectsManager 独立管理，AudioManager 不再处理任何视觉反馈。"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.7, 0.7, 0.8, 1)
autowrap_mode = 3
